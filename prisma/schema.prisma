generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model User { id String @id @default(cuid()) name String? email String? phone String? createdAt DateTime @default(now()) cases Case[] }
model ProblemType { id String @id name String category String route String priority String questions Json evidence Json createdAt DateTime @default(now()) cases Case[] }
model Case { id String @id @default(cuid()) title String category String priority String status String @default("DRAFT") description String? location String? userId String? problemId String? createdAt DateTime @default(now()) updatedAt DateTime @updatedAt user User? @relation(fields:[userId],references:[id]) problem ProblemType? @relation(fields:[problemId],references:[id]) events StatusEvent[] payments Payment[] }
model StatusEvent { id String @id @default(cuid()) caseId String status String note String? createdAt DateTime @default(now()) case Case @relation(fields:[caseId],references:[id],onDelete:Cascade) }
model Payment { id String @id @default(cuid()) caseId String? amount Int status String @default("PENDING") providerRef String? createdAt DateTime @default(now()) case Case? @relation(fields:[caseId],references:[id]) }
